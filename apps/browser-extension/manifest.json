{
  "manifest_version": 3,
  "name": "Lattix Locus",
  "short_name": "Locus",
  "version": "0.1.0",
  "description": "Lets your local Lattix Locus agent work in tabs you share, under the browser tier you choose. Every action is authorized by Locus first.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Lattix Locus",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "locus-browser@lattix.io",
      "strict_min_version": "128.0"
    }
  }
}

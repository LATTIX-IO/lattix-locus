# Host folder that contains the repos/projects you want agents to work in.
# It is bind-mounted into the backend + agent containers at LOCUS_PROJECTS_ROOT
# (/projects). Working folders selected in the composer are confined under it.
LOCUS_PROJECTS_HOST=D:/lattix
LOCUS_PROJECTS_ROOT=/projects
DATABASE_URL=postgresql://lattix:lattix@postgres:5432/lattix
POSTGRES_DSN=postgresql://locus:locus@postgres:5432/locus
REDIS_URL=redis://redis:6379/0
LOCUS_STATE_STORE=.locus/state.db
LOCUS_MEMORY_ENABLE_LONG_TERM=true
LOCUS_MEMORY_LEARNING_ENABLED=true
LOCUS_MEMORY_CONSOLIDATION_ENABLED=true
LOCUS_MEMORY_CONSOLIDATION_MIN_CANDIDATES=2
LOCUS_MEMORY_TASK_LEARNING_MIN_CANDIDATES=1
LOCUS_MEMORY_CONSOLIDATION_MAX_POINTS=5
LOCUS_MEMORY_CONSOLIDATION_DUPLICATE_MIN_OVERLAP=80
LOCUS_MEMORY_CONSOLIDATION_DUPLICATE_HISTORY_LIMIT=25
LOCUS_MEMORY_HYBRID_RETRIEVAL_ENABLED=true
LOCUS_MEMORY_HYBRID_MAX_TOKENS=1200
LOCUS_MEMORY_HYBRID_MAX_TOPICS=8
LOCUS_MEMORY_GRAPH_PROJECTION_ENABLED=true
LOCUS_MEMORY_GRAPH_MAX_TOPICS=5
LOCUS_MEMORY_GRAPH_TOPIC_MIN_OCCURRENCES=2
# Long-term memory store (LOCUS-387): postgres when POSTGRES_DSN is set, else the
# embedded SQLite store on the desktop/SQLite-state profiles. Force one with:
# LOCUS_MEMORY_STORE=sqlite
# LOCUS_MEMORY_SQLITE_PATH=<app_home>/data/memory/locus-memory.db
# Memory embeddings run on the local engine (Ollama) through the gated model
# client (LOCUS-378); empty disables semantic search (keyword search stays on).
LOCUS_MEMORY_EMBEDDING_MODEL=nomic-embed-text
LOCUS_MEMORY_EMBEDDING_DIMENSIONS=768
# Model engines (LOCUS-336, D-21). Provider API keys (NVIDIA_API_KEY, OPENAI_API_KEY, ...)
# belong in the OS keychain: PUT /models/providers/{provider}/key (admin) or Settings.
# Agent/self-improvement tiers: hosted NIM first, local Ollama fallback (recorded, never silent).
# LOCUS_AGENT_MODEL_CHAIN=nim/nvidia/nemotron-3-ultra-550b-a55b,ollama/gpt-oss:20b
# NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LOCUS_NIM_CONTEXT_TOKENS=131072
# LOCUS_MODEL_LOCAL_FALLBACK=1
# Per-run model budget enforced by the gateway (budget_policy); unset = no limit.
# LOCUS_MODEL_MAX_TOKENS_PER_RUN=2000000
# LOCUS_MODEL_MAX_COST_USD_PER_RUN=5
# USD per million tokens [in, out] for spend estimates (NIM free tier / Ollama = 0).
# LOCUS_MODEL_PRICES={"openai/gpt-5.2": [1.25, 10.0]}
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN
OPA_ADDR=http://opa:8181
NATS_URL=nats://nats:4222
JAEGER_ENDPOINT=http://jaeger:4317
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
LOCUS_RUNTIME_PROFILE=local-secure
LOCUS_SECURE_LOCAL_MODE=true
LOCUS_REQUIRE_AUTHENTICATED_REQUESTS=true
LOCUS_REQUIRE_A2A_RUNTIME_HEADERS=false
LOCUS_ALLOW_HEADER_ACTOR_AUTH=false
LOCUS_LOCAL_BOOTSTRAP_AUTHENTICATED_OPERATOR=true
LOCUS_API_BEARER_TOKEN=
NEXT_PUBLIC_LOCUS_ACTOR=
LOCUS_BOOTSTRAP_ADMIN_USERNAME=locus-admin
LOCUS_BOOTSTRAP_ADMIN_EMAIL=admin@locus.localhost
LOCUS_BOOTSTRAP_ADMIN_SUBJECT=locus-admin
LOCUS_ADMIN_ACTORS=locus-admin,admin@locus.localhost
LOCUS_BUILDER_ACTORS=locus-admin,admin@locus.localhost
LOCUS_AUTH_MODE=oidc
LOCUS_AUTH_OIDC_PROVIDER=casdoor
LOCUS_AUTH_OIDC_ISSUER=http://127.0.0.1:8081
LOCUS_AUTH_OIDC_AUDIENCE=locus-ui
LOCUS_AUTH_OIDC_JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json
LOCUS_AUTH_OIDC_CLIENT_ID=locus-web
LOCUS_AUTH_OIDC_AUTHORIZATION_URL=http://127.0.0.1:8081/login/oauth/authorize
LOCUS_AUTH_OIDC_TOKEN_URL=http://127.0.0.1:8081/api/login/oauth/access_token
LOCUS_AUTH_OIDC_SIGNIN_URL=http://127.0.0.1:8081/login/oauth/authorize
LOCUS_AUTH_OIDC_SIGNUP_URL=http://127.0.0.1:8081/login/oauth/authorize
LOCUS_AUTH_OIDC_SCOPES=openid profile email
CASDOOR_LOCAL_HOST=casdoor.localhost
CASDOOR_BIND_HOST=127.0.0.1
CASDOOR_HTTP_PORT=8081
CASDOOR_PUBLIC_URL=http://127.0.0.1:8081
CASDOOR_BOOTSTRAP_ADMIN_USERNAME=locus-admin
CASDOOR_BOOTSTRAP_ADMIN_EMAIL=admin@locus.localhost
CASDOOR_BOOTSTRAP_LOGIN_USERNAME=
CASDOOR_BOOTSTRAP_LOGIN_EMAIL=
CASDOOR_BOOTSTRAP_LOGIN_DISPLAY_NAME=
CASDOOR_BOOTSTRAP_LOGIN_PASSWORD=SET_AT_INSTALL_TIME
A2A_JWT_ALG=HS256
A2A_JWT_ISS=lattix-locus
A2A_JWT_AUD=locus-runtime
A2A_JWT_SECRET=GENERATED_AT_INSTALL_TIME
LOCUS_SECRETS_ENCRYPTION_KEY=GENERATED_AT_INSTALL_TIME
A2A_REQUIRE_NONCE=true
A2A_REPLAY_PROTECTION=true
A2A_CLOCK_SKEW_SECONDS=30
A2A_REPLAY_TTL_SECONDS=900
A2A_TRUSTED_SUBJECTS=backend,research,code,review,coordinator
BISCUIT_ROOT_SECRET=change-me-in-production
JWT_SECRET=change-me-too
LOCUS_AGENT_IMAGE=lattix-locus/agent-base:3.12.10-slim-bookworm
LOCUS_AGENT_PYTHON_BASE_IMAGE=python:3.12.10-slim-bookworm
SANDBOX_RUNNER_IMAGE=python:3.12.10-slim-bookworm
SANDBOX_INTERNAL_NETWORK=locus-sandbox-internal
SANDBOX_EGRESS_GATEWAY=sandbox-egress-gateway:3128
SANDBOX_WORKSPACE_ROOT=.sandbox
SANDBOX_ALLOW_LIVE_EXECUTION=false
# Three-tier hybrid sandbox configuration
# LOCUS_SECCOMP_PROFILE: Path to custom seccomp BPF profile (blocks ptrace, io_uring, mount, bpf, etc.)
LOCUS_SECCOMP_PROFILE=docker/sandbox/seccomp-strict.json
# Sandbox resource limits (applied in hardened Docker and K8s modes)
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PID_LIMIT=256
SANDBOX_TIMEOUT_SECONDS=60
LOCAL_STACK_HOST=locus.local
LOCAL_GATEWAY_HTTP_PORT=80
NEXT_PUBLIC_API_BASE_URL=/api
# Optional absolute UI base URL for OAuth callbacks when the UI and API use different origins.
# Loopback desktop installs default to port 3000; same-origin deployments need no override.
# LOCUS_FRONTEND_URL=https://locus.example.com
LOCUS_LOCAL_API_BASE_URL=http://127.0.0.1/api
LOCUS_AGENT_ASSETS_ROOT=examples/agents
INSTALLER_PUBLIC_REPO=https://github.com/LATTIX-IO/lattix-locus.git
INSTALLER_DEFAULT_REF=main
FEDERATION_ENABLED=false
FEDERATION_CLUSTER_NAME=local-locus
FEDERATION_REGION=local
FEDERATION_PEER_ENDPOINTS=
POSTGRES_USER=locus
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=locus
POSTGRES_DSN=postgresql://locus:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/locus
# World-models / knowledge graph are hosted in Postgres (PostgresWorldGraph) — no
# Neo4j / no Java. To opt into the legacy Neo4j backend instead, set NEO4J_URI
# (+ NEO4J_USERNAME / NEO4J_PASSWORD) and run your own Neo4j.
